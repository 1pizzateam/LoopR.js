{
  "name": "@1pizzateam/loopr",
  "version": "2.1.0",
  "description": "Lightweight animation loop manager with FPS capping and delta-time clock",
  "keywords": [
    "animation",
    "loop",
    "game-loop",
    "render-loop",
    "requestanimationframe",
    "clock",
    "delta-time",
    "fps",
    "framerate",
    "typescript"
  ],
  "homepage": "https://github.com/1pizzateam/LoopR.js",
  "type": "module",
  "sideEffects": false,
  "main": "dist/loopr.js",
  "types": "dist/loopr.d.ts",
  "exports": {
    ".": {
      "types": "./dist/loopr.d.ts",
      "import": "./dist/loopr.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1pizzateam/LoopR.js.git"
  },
  "bugs": {
    "url": "https://github.com/1pizzateam/LoopR.js/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ludovic Cluber"
  },
  "contributors": [],
  "scripts": {
    "prebuild": "npm install",
    "build": "npm run build:lib && npm run test",
    "build:lib": "node ./scripts/clear.js && tsc && npm run rollup && node ./scripts/copy.js",
    "rollup": "rollup --config rollup.config.mjs",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@dwtechs/checkard": "3.7.0",
    "@1pizzateam/spock": "4.1.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "26.4.1",
    "jest": "29.7.0",
    "rollup": "4.63.1",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "6.0.3"
  }
}
